{
    "name": "manuxi/sulu-admin-extras-bundle",
    "description": "Admin UI extensions for Sulu CMS - Property Resolvers and List Field Transformers",
    "type": "symfony-bundle",
    "homepage": "https://github.com/manuxi/SuluAdminExtrasBundle",
    "license": "MIT",
    "keywords": [
        "sulu",
        "admin",
        "content-type",
        "transformer",
        "List Field Transformers",
        "Property Resolvers",
        "color-select",
        "publish-state",
        "number-default",
        "star-rating",
        "slider-range",
        "publish-state"
    ],
    "authors": [
        {
            "name": "Manuxi",
            "homepage": "https://github.com/manuxi"
        }
    ],
    "require": {
        "php": "^8.1",
        "sulu/sulu": "^3.0",
        "symfony/config": "^5.4 || ^6.0 || ^7.0",
        "symfony/dependency-injection": "^5.4 || ^6.0 || ^7.0",
        "symfony/http-kernel": "^5.4 || ^6.0 || ^7.0",
        "symfony/translation-contracts": "^2.5 || ^3.0"
    },
    "require-dev": {
        "jackalope/jackalope-doctrine-dbal": "^1.3.4",
        "phpunit/phpunit": "^9.5 || ^10.0",
        "friendsofphp/php-cs-fixer": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Manuxi\\SuluAdminExtrasBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Manuxi\\SuluAdminExtrasBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
